# ---------------------------------------------------------------------------
# Mizaan — backend environment template
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

APP_ENV=development
APP_NAME=Mizaan API
APP_VERSION=1.4.0

# --- Database --------------------------------------------------------------
DATABASE_URL=sqlite:///./mizaan.db

# --- Auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MIN_PASSWORD_LENGTH=8

# --- CORS (comma separated, explicit origins in production) ---------------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://47.253.196.234,http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
# --- Usage quota -----------------------------------------------------------
DAILY_AUDIT_LIMIT=5

# --- AI engine -------------------------------------------------------------
GEMINI_API_KEY=API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash


# --- Email / OTP -----------------------------------------------------------
# SMTP_SENDER_PASSWORD must be an app-specific password, never an account
# password. Leave blank here; supply it via the deployment secret store.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SENDER_EMAIL=
SMTP_SENDER_PASSWORD=
OTP_TTL_MINUTES=10

OTP_MAX_ATTEMPTS=5
LOG_OTP_TO_CONSOLE=false

# --- Upload / scraping limits ---------------------------------------------
MAX_UPLOAD_FILES=5
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_CHARS=12000
MAX_SCRAPE_CHARS=15000
MAX_SCRAPE_BYTES=2097152
SCRAPE_TIMEOUT_SECONDS=5
MAX_QUESTION_CHARS=4000

# --- Donations (subscriptions/payments removed) ---------------------------
DONATIONS_ENABLED=true
DONATION_URL=
DONATION_NOTE=Mizaan is free to use. Voluntary donations (sadaqah) keep the research engine running. No subscription, no paywall.
